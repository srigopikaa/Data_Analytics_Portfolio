create database Medical_Data_History;
use Medical_Data_History;
SHOW TABLES FROM Medical_Data_History;

-- 1. Show first name, last name, and gender of patients who's gender is 'M':

	select first_name,last_name,gender from patients_table where gender="M";

-- 2. Show first name and last name of patients who does not have allergies:

	select first_name,last_name from patients_table where allergies="";

-- 3. Show first name of patients that start with the letter 'C':

	select first_name from patients_table where first_name like 'c%';

-- 4. Show first name and last name of patients that weight within the range of 100 to 120 (inclusive):

	select first_name,last_name from patients_table where weight>=100 and weight<=120; 

-- 5. Update the patients table for the allergies column. 
		-- If the patient's allergies is null then replace it with 'NKA':
		-- Create a duplicate copy of the patients table
		-- so that the original table remains unchanged.
        -- Run the create table code only once
		CREATE TABLE patients_table_copy AS
		SELECT *
		FROM patients_table;

		-- Check the allergies column to determine whether
		-- blank values are NULL or empty strings.
		-- is_null = 1 means the value is NULL.
		-- length_value = 0 means the value is an empty string.
		SELECT allergies,
			   allergies IS NULL AS is_null,
			   LENGTH(allergies) AS length_value
		FROM patients_table_copy;


		-- Disable MySQL Safe Update Mode temporarily
		-- to allow the UPDATE statement.
		SET SQL_SAFE_UPDATES = 0;


		-- Replace empty values ('') in the allergies column
		-- with 'NKA' (No Known Allergies).
		UPDATE patients_table_copy
		SET allergies = 'NKA'
		WHERE allergies = '';


		-- Display the updated patients table to verify
		-- that the blank allergies values have been replaced with 'NKA'.
		SELECT *
		FROM patients_table_copy;

