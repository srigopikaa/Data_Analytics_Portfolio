	-- Primary diagnosis is stored in the admissions table.

	-- Using Subquery
	select patient_id,first_name,last_name from patients_table where patient_id in (select patient_id from administration_table where diagnosis='Dementia');
	-- Using Join
	select p.patient_id,p.first_name,p.last_name from patients_table p left join  administration_table a on p.patient_id=a.patient_id where diagnosis='Dementia';

